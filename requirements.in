# Dépendances DIRECTES du projet, avec les plages de versions acceptées.
#
# Ce fichier n'est pas installé tel quel : le serveur installe
# requirements.txt, qui fige la version exacte de chaque paquet (dépendances
# des dépendances comprises) pour que la production tourne avec les mêmes
# versions que celles testées. Pour mettre à jour, voir requirements.txt.

wagtail>=7.4,<7.5   # 7.4 = version LTS, maintenue jusqu’au 2 novembre 2027
django>=5.2,<5.3    # 5.2 = version LTS de Django
Pillow>=10.0
whitenoise>=6.6

# Base de données de production (o2switch propose PostgreSQL et MySQL)
psycopg2-binary>=2.9   # PostgreSQL
PyMySQL>=1.1           # MySQL/MariaDB (seulement si DB_ENGINE=mysql)

# Lecture du fichier src/.env en production
python-dotenv>=1.0

# Serveur d'application hors cPanel (inutile sur o2switch, Passenger s'en charge)
gunicorn>=22.0

# Référencement (SEO) : balises meta, Open Graph, Twitter Card, données
# structurées Schema.org
wagtail-seo>=3.1,<4   # 3.1 accepte Wagtail jusqu’à 7.x (pas 8)

# Génération du contrat de location en PDF (app 'calendrier')
reportlab>=4.0
pypdf>=5.0
