# Copier ce fichier en src/.env sur le serveur, puis remplir les valeurs.
# Ne jamais versionner le vrai .env sur GitHub.

# Clé secrète : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=a-remplacer

# Domaines autorisés, séparés par des virgules, sans espace ni https://
ALLOWED_HOSTS=la-concorde.be,www.la-concorde.be
BASE_URL=https://www.la-concorde.be

# Base de données : postgresql (recommandé), mysql ou sqlite
DB_ENGINE=postgresql
DB_NAME=compte_concorde
DB_USER=compte_concorde
DB_PASSWORD=a-remplacer
DB_HOST=localhost
DB_PORT=5432

# Chemins sur le serveur (remplacer "compte" par l'identifiant cPanel)
STATIC_ROOT=/home/compte/concorde/src/staticfiles
MEDIA_ROOT=/home/compte/public_html/media
LOG_FILE=/home/compte/concorde/src/django-erreurs.log

# 1 = Django sert /media/ lui-même (seulement si Apache ne le fait pas)
SERVE_MEDIA=0

# Mettre à 0 tant que le certificat HTTPS n'est pas actif
SECURE_SSL_REDIRECT=1
# 3600 au début, puis 31536000 une fois le HTTPS validé
SECURE_HSTS_SECONDS=3600

# --- E-mails (SMTP o2switch) ----------------------------------------------
# Serveur : mail.<votre-domaine> (ou le nom du serveur indiqué dans l'e-mail
# de bienvenue o2switch / cPanel > Connecter des appareils).
# Port 465 = SSL (recommandé) ; port 587 = STARTTLS.
# Sans EMAIL_HOST, les e-mails s'affichent dans la console (développement).
EMAIL_HOST=mail.la-concorde.be
EMAIL_PORT=465
EMAIL_HOST_USER=infos@la-concorde.be
EMAIL_HOST_PASSWORD=a-remplacer
DEFAULT_FROM_EMAIL=La Concorde asbl <infos@la-concorde.be>

# --- Newsletter -------------------------------------------------------------
# Expéditeur (doit être une boîte du domaine, sinon les messages finissent en spam)
NEWSLETTER_FROM_EMAIL=La Concorde asbl <infos@la-concorde.be>
NEWSLETTER_REPLY_TO=infos@la-concorde.be
# Adresse publique du site, pour les liens et images des e-mails
NEWSLETTER_BASE_URL=https://www.la-concorde.be
# Cadence : messages par passage de la tâche cron (toutes les 5 min),
# pause entre deux messages, plafond sur une heure glissante.
NEWSLETTER_LOT_TAILLE=15
NEWSLETTER_PAUSE_SECONDES=2
NEWSLETTER_MAX_PAR_HEURE=150
